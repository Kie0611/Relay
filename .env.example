PORT=4000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
REDIS_URL=redis://127.0.0.1:6379

# Set to true outside local development to enforce project API keys.
RELAY_AUTH_REQUIRED=false
RELAY_ADMIN_KEY=replace-with-a-long-admin-secret

# Base64 encoding of exactly 32 random bytes for AES-256-GCM.
RELAY_SECRET_ENCRYPTION_KEY=base64-32-byte-key

RELAY_MAX_ATTEMPTS=5
RELAY_RETRY_BASE_DELAY_MS=1000
RELAY_LEASE_DURATION_MS=30000
RELAY_WEBHOOK_TIMEOUT_MS=10000
WORKER_ID=relay-worker-local

DASHBOARD_ORIGIN=http://localhost:3000
NEXT_PUBLIC_RELAY_API_URL=http://localhost:4000/api
